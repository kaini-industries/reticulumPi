[Unit]
Description=Reticulum Network Stack Daemon
After=network.target i2pd.service
# If i2pd is installed, wait for it to start (SAM API needs to be ready)
# This is a soft dependency — rnsd still starts without i2pd
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
User=reticulumpi
Group=reticulumpi
Environment=HOME=/var/lib/reticulumpi
Environment=XDG_CONFIG_HOME=/var/lib/reticulumpi/.config
Environment=XDG_DATA_HOME=/var/lib/reticulumpi/.local/share
Environment=XDG_STATE_HOME=/var/lib/reticulumpi/.local/state
Environment=XDG_CACHE_HOME=/var/cache/reticulumpi
WorkingDirectory=/var/lib/reticulumpi
UMask=0077
ExecStart=/opt/reticulumpi/current/.venv/bin/rnsd

# Ensure Python tracebacks and RNS logs appear in journalctl
StandardOutput=journal
StandardError=journal

# Restart policy with backoff to prevent crash-loop storms
Restart=on-failure
RestartSec=10
# Give I2P interface time to connect to SAM API on restart
ExecStartPre=/bin/sleep 3

# Readiness gate: fail startup if the shared-instance socket never binds.
# rnsd has been observed to wedge during interface init (main loop ticking
# but @rns/default never appears), causing reticulumpi.service to
# crash-loop silently. Failing here trips Restart=on-failure and recovers.
ExecStartPost=/bin/bash -c 'for i in $(seq 1 60); do ss -xa 2>/dev/null | grep -q "@rns/default" && exit 0; sleep 1; done; exit 1'
TimeoutStartSec=120

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
StateDirectory=reticulumpi
StateDirectoryMode=0750
CacheDirectory=reticulumpi
CacheDirectoryMode=0750
ReadWritePaths=/var/lib/reticulumpi /var/cache/reticulumpi
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
