[Unit]
Description=ReticulumPi Network Node
After=network-online.target rnsd.service
Wants=network-online.target rnsd.service

[Service]
Type=simple
User=reticulumpi
Group=reticulumpi
Environment=PATH=/opt/reticulumpi/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Wait for rnsd shared instance to be ready before starting.
# RNS 1.1.4+ uses abstract Unix socket @rns/default (visible in ss -xa).
# rnsd can take 30-60s to initialize serial interfaces (RNode, Meshtastic).
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do ss -xa 2>/dev/null | grep -q "@rns/default" && exit 0; sleep 1; done; echo "rnsd not ready after 60s, starting anyway"; exit 0'
ExecStart=/opt/reticulumpi/.venv/bin/reticulumpi --config /etc/reticulumpi/config.yaml
# Restart=always ensures reticulumpi recovers when rnsd restarts
# (rnsd restart closes the shared instance socket, causing a clean exit)
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

# Security hardening
# NOTE: NoNewPrivileges is intentionally omitted. The dashboard's
# "Restart Services" button needs to run:
#   sudo systemctl restart rnsd
#   sudo systemctl restart reticulumpi
# via the /etc/sudoers.d/reticulumpi-services NOPASSWD rule.
# NoNewPrivileges=yes blocks sudo entirely ("no new privileges" flag error).
# The reticulumpi user is already unprivileged, and the sudoers rule
# restricts escalation to exactly those two systemctl commands.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/reticulumpi /home/reticulumpi/.reticulum /home/reticulumpi/.config/reticulumpi /home/reticulumpi/.local/share/reticulumpi /home/reticulumpi/.nomadnet /home/reticulumpi/.nomadnet-tui /opt/reticulumpi/meshchat/storage
PrivateTmp=yes

# Resource limits — prevent runaway plugins from starving the system
# NOTE: RNS spawns a new thread for every announce callback. With 3
# subprocesses (reticulumpi + nomadnet + meshchat) and an active mesh
# (14k+ nodes), thread counts can spike during announce storms.
# network_map uses a queue-based architecture to cap its own threads,
# but other RNS consumers (meshchat, nomadnet) still spawn freely.
MemoryMax=1G
TasksMax=2048
CPUQuota=90%

[Install]
WantedBy=multi-user.target
