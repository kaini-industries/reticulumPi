[Unit]
Description=ReticulumPi Network Node
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=reticulumpi
Group=reticulumpi
Environment=PATH=/opt/reticulumpi/current/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/lib/reticulumpi
Environment=XDG_CONFIG_HOME=/var/lib/reticulumpi/.config
Environment=XDG_DATA_HOME=/var/lib/reticulumpi/.local/share
Environment=XDG_STATE_HOME=/var/lib/reticulumpi/.local/state
Environment=XDG_CACHE_HOME=/var/cache/reticulumpi
Environment=RETICULUMPI_RUNTIME_OVERRIDES=/var/lib/reticulumpi/runtime-overrides.yaml
WorkingDirectory=/var/lib/reticulumpi
UMask=0077
ExecStart=/opt/reticulumpi/current/.venv/bin/reticulumpi --config /etc/reticulumpi/config.yaml
# Restart=always ensures reticulumpi recovers when rnsd restarts
# (rnsd restart closes the shared instance socket, causing a clean exit)
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStartSec=120
TimeoutStopSec=60

# Security hardening. Privileged operations go through the root-owned,
# peer-credential-checking reticulumpi-control socket; the service itself can
# never gain privileges; upgrades remove every legacy runtime sudo rule.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
StateDirectory=reticulumpi
StateDirectoryMode=0750
CacheDirectory=reticulumpi
CacheDirectoryMode=0750
ReadWritePaths=/var/lib/reticulumpi /var/cache/reticulumpi
PrivateTmp=yes
RuntimeDirectory=reticulumpi
RuntimeDirectoryMode=0750

# Resource limits — prevent runaway plugins from starving the system
# MemoryHigh triggers kernel reclaim pressure before the hard MemoryMax
# wall, giving the cgroup breathing room instead of sudden swap death.
MemoryHigh=1536M
MemoryMax=2G
TasksMax=2048
CPUQuota=90%

[Install]
WantedBy=multi-user.target
