[Unit]
Description=ReticulumPi Network Node
After=network-online.target rnsd.service
Wants=network-online.target rnsd.service

[Service]
Type=simple
User=reticulumpi
Group=reticulumpi
Environment=PATH=/opt/reticulumpi/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/reticulumpi/.venv/bin/reticulumpi --config /etc/reticulumpi/config.yaml
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

# Security hardening
# NOTE: NoNewPrivileges is intentionally omitted. The dashboard's
# "Restart Services" button needs to run:
#   sudo systemctl restart rnsd
#   sudo systemctl restart reticulumpi
# via the /etc/sudoers.d/reticulumpi-services NOPASSWD rule.
# NoNewPrivileges=yes blocks sudo entirely ("no new privileges" flag error).
# The reticulumpi user is already unprivileged, and the sudoers rule
# restricts escalation to exactly those two systemctl commands.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/reticulumpi /home/reticulumpi/.reticulum /home/reticulumpi/.config/reticulumpi /home/reticulumpi/.local/share/reticulumpi /home/reticulumpi/.nomadnet /home/reticulumpi/.nomadnet-tui /opt/reticulumpi/meshchat/storage
PrivateTmp=yes

# Resource limits — prevent runaway plugins from starving the system
MemoryMax=512M
TasksMax=128
CPUQuota=90%

[Install]
WantedBy=multi-user.target
