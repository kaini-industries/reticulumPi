      "Bash(sudo rm -rf /etc:*)",
      "Bash(sudo rm -rf /var:*)",
      "Bash(git add .env:*)",
      "Bash(git add *.identity:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/reticulum/reticulumPi && echo '--- Node State ---' && printf 'rnsd: ' && systemctl is-active rnsd 2>/dev/null && printf 'reticulumpi: ' && systemctl is-active reticulumpi 2>/dev/null && echo && echo '--- Recent Commits ---' && git log --oneline -3 && echo && echo '--- Uncommitted Changes ---' && git diff --stat HEAD 2>/dev/null | tail -5 && MARKER=$(grep -oP '(?<=Last reviewed: )\\d{4}-\\d{2}-\\d{2}' CLAUDE.md 2>/dev/null) && if [ -z \"$MARKER\" ]; then echo && echo 'CLAUDE.md has no review marker -- consider running /review-claude'; elif [ $(( ($(date +%s) - $(date -d \"$MARKER\" +%s)) / 86400 )) -gt 90 ]; then echo && echo \"CLAUDE.md last reviewed $MARKER ($(( ($(date +%s) - $(date -d \"$MARKER\" +%s)) / 86400 )) days ago) -- consider running /review-claude\"; fi; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$CLAUDE_FILE_PATH\"; if echo \"$FILE\" | grep -qE \"\\.py$\"; then cd /home/reticulum/reticulumPi && .venv/bin/ruff check --no-fix --quiet \"$FILE\" 2>/dev/null; fi; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/reticulum/reticulumPi && echo \"--- Session summary ---\" && echo \"Changed files:\" && git diff --stat HEAD 2>/dev/null | tail -5 && echo && echo \"Services:\" && systemctl is-active reticulumpi rnsd 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
